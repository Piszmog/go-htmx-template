root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md,css}]
indent_style = space
indent_size = 2

# just recipes are indented with spaces; `just --fmt` normalizes to four.
[justfile]
indent_style = space
indent_size = 4
