# Server Configuration
# Port the HTTP server listens on
PORT=8080

# Trust X-Forwarded-For / X-Real-IP from a single reverse proxy (default: false).
# Only enable when the server is not directly reachable by clients.
TRUST_PROXY_HEADERS=false

# Logging Configuration
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log output format: text, json
LOG_OUTPUT=text

# Database Configuration
# Path to SQLite database file (a plain path or file: URL)
DB_URL=./db.sqlite3

# Apply embedded migrations when the server starts (default: false).
# Prefer the explicit `migrate` subcommand unless a single-container deployment
# needs to initialize its database automatically.
MIGRATE_ON_START=false

# Rate Limiting Configuration
# Maximum requests per minute per IP address (default: 50)
RATE_LIMIT=50

# Development Notes:
# - The app does not load .env automatically. Export these variables, or use
#   a tool such as direnv, before starting the server or air.
# - Never commit secrets or credentials to version control.
