package core

import "go-htmx-template/internal/version"

templ HTML(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		@body(content)
	</html>
}

templ head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="color-scheme" content="light dark"/>
		<meta name="description" content="Hello world"/>
		<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
		<title>{ title }</title>
		<script src="/assets/js/htmx@v4.0.0.min.js" nonce={ templ.GetNonce(ctx) }></script>
		<script nonce={ templ.GetNonce(ctx) }>
			// htmx stamps this nonce onto any script it re-creates from a swapped fragment.
			htmx.config.inlineScriptNonce = document.currentScript.nonce;
		</script>
		<link href={ "/assets/css/output@" + version.Value + ".css" } rel="stylesheet"/>
	</head>
}

templ body(content templ.Component) {
	<body class="flex min-h-screen flex-col bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4">Skip to content</a>
		<div id="error-region"></div>
		<main id="main-content" class="grow">
			@content
		</main>
	</body>
}
